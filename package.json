{
  "name": "etsy-listing-optimizer-mcp",
  "version": "1.0.0",
  "description": "Etsy listing SEO MCP server: titles within 140 chars, 13 tags within 20 chars, structured descriptions, listing scores and keyword clustering. Deterministic, no Etsy API keys.",
  "type": "module",
  "license": "MIT",
  "author": "Paris Piotis",
  "repository": {
    "type": "git",
    "url": "https://github.com/ppiotis/etsy-listing-optimizer-mcp"
  },
  "homepage": "https://github.com/ppiotis/etsy-listing-optimizer-mcp#readme",
  "keywords": [
    "mcp",
    "etsy",
    "seo",
    "ecommerce",
    "digital-products",
    "grok-bot",
    "cursor-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "etsy-listing-optimizer-mcp": "dist/stdio.js",
    "etsy-listing-optimizer-mcp-http": "dist/serve-http.js"
  },
  "files": [
    "dist",
    "skills",
    ".mcp.json",
    "plugin.json",
    ".cursor-plugin",
    "logo.svg"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/stdio.js",
    "start:http": "node dist/serve-http.js",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
